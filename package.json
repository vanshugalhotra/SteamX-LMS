{
  "name": "steamx-lms",
  "version": "0.0.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": ">=24"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.8.1",
      "onFail": "download"
    }
  },
  "scripts": {
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "test": "pnpm test:backend && pnpm test:frontend",
    "test:backend": "pnpm --filter @steamx/backend test",
    "test:frontend": "pnpm --filter frontend test",
    "test:unit": "pnpm --filter @steamx/backend test:unit",
    "test:db": "pnpm --filter @steamx/backend test:db",
    "test:e2e": "pnpm --filter @steamx/backend test:e2e",
    "test:invariants": "pnpm --filter @steamx/backend test:invariants",
    "typecheck": "pnpm -r typecheck",
    "db:test:seed": "pnpm --filter @steamx/backend db:test:seed",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dev:backend": "pnpm --filter @steamx/backend start:dev",
    "infra:install": "pnpm --dir infra install --ignore-workspace --allow-build esbuild",
    "infra:synth": "pnpm --dir infra exec cdk synth",
    "infra:diff": "pnpm --dir infra exec cdk diff",
    "infra:deploy": "pnpm --dir infra exec cdk deploy --require-approval broadening",
    "infra:destroy": "pnpm --dir infra exec cdk destroy SteamxStagingStack --context env=staging",
    "infra:test": "pnpm --dir infra exec vitest run",
    "assets:smoke": "pnpm --dir apps/backend asset:smoke",
    "infra:stop": "node -e \"console.log('Nothing to stop/start yet: staging is S3 only')\"",
    "infra:start": "node -e \"console.log('Nothing to stop/start yet: staging is S3 only')\""
  },
  "devDependencies": {
    "prettier": "^3.9.9",
    "typescript": "~6.0.3"
  }
}
