# Optional CDK deployment region; the CDK context value `region` takes precedence.
AWS_REGION=ap-south-1
# Required by the CDK stack for budget alerts.
STEAMX_BUDGET_EMAIL=replace-with-alert-email
STEAMX_CORS_ORIGINS=http://localhost:5173

# This file is for infrastructure settings, not backend runtime configuration.
# CDK reads these values from the process environment; it does not load this file automatically.
# S3_BUCKET and the backend's optional AWS credentials belong in apps/backend/.env instead.
