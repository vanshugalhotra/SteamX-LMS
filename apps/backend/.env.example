# ─────────────────────────────────────────
# Database
# ─────────────────────────────────────────
DATABASE_URL=postgresql://steamx_local:local_dev_password@localhost:5432/steamx_lms
DB_POOL_MAX=10
DB_CONNECTION_TIMEOUT_MS=5000

# ─────────────────────────────────────────
# App Core
# ─────────────────────────────────────────

NODE_ENV=development
PORT=3000
CORS_ORIGINS=http://localhost:5173
SWAGGER_ENABLED=true

# ─────────────────────────────────────────
# Authentication
# ─────────────────────────────────────────
# Generate with: openssl rand -base64 48
AUTH_JWT_SECRET=replace-with-a-secret-at-least-32-characters
AUTH_TOKEN_TTL_SECONDS=86400

# ─────────────────────────────────────────
# First Admin (one-time setup)
# ─────────────────────────────────────────
# ADMIN_STEAMX_ID=ADM-SXSX-SXSX
# ADMIN_PASSWORD=replace-with-a-strong-password
# ADMIN_NAME=Platform Admin

# ─────────────────────────────────────────
# Logging
# ─────────────────────────────────────────
LOG_LEVEL=info

# ─────────────────────────────────────────
# S3 Storage
# ─────────────────────────────────────────
# Required AWS region and the bucket the backend stores objects in.
AWS_REGION=ap-south-1
S3_BUCKET=replace-with-s3-bucket
# For local/staging credentials, set both values. Leave both empty to use the AWS default credential chain.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Lifetime of presigned upload URLs (15 minutes); download URLs set their own TTL per request,
# with a separate hard maximum of 12 hours.
UPLOAD_URL_TTL_SECONDS=900
# Cleanup runs in the API process; set false in automated test environments.
CLEANUP_ENABLED=true
CLEANUP_INTERVAL_SECONDS=300
CLEANUP_BATCH_SIZE=50
ASSET_STALE_FILE_AFTER_HOURS=24
# S3 checks expiry on every request and players/PDF viewers keep requesting ranges, so TTLs must
# cover normal viewing; clients re-request a URL when a fetch returns 403.
ASSET_ACCESS_TTL_IMAGE_SECONDS=600
ASSET_ACCESS_TTL_PDF_SECONDS=1800
ASSET_ACCESS_TTL_VIDEO_SECONDS=7200
# Maximum image upload size: 10 MiB.
ASSET_MAX_BYTES_IMAGE=10485760
# Maximum PDF upload size: 50 MiB.
ASSET_MAX_BYTES_PDF=52428800
# Maximum video upload size: 1 GiB.
ASSET_MAX_BYTES_VIDEO=1073741824
