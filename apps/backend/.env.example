# ─────────────────────────────────────────
# Database
# ─────────────────────────────────────────
DATABASE_URL=postgresql://steamx_local:local_dev_password@localhost:5432/steamx_lms
MAX_DB_TIMEOUT=5000
MAX_DB_CONNECTIONS=20

# ─────────────────────────────────────────
# App Core
# ─────────────────────────────────────────

NODE_ENV=development
PORT=3000
CORS_ORIGINS=http://localhost:5173
SWAGGER_ENABLED=true

# ─────────────────────────────────────────
# Logging
# ─────────────────────────────────────────
LOG_LEVEL=info
