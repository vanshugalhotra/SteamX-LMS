# ─────────────────────────────────────────
# Database
# ─────────────────────────────────────────
DATABASE_URL=postgresql://postgres:1228@localhost:5432/steamx_lms_test

DB_POOL_MAX=10
DB_CONNECTION_TIMEOUT_MS=5000
# ─────────────────────────────────────────
# App Core
# ─────────────────────────────────────────

NODE_ENV=development
PORT=3333
CORS_ORIGINS=http://localhost:5173
SWAGGER_ENABLED=true

# ─────────────────────────────────────────
# Logging
# ─────────────────────────────────────────
LOG_LEVEL=silent

# ─────────────────────────────────────────
# Authentication
# ─────────────────────────────────────────
# Generate with: openssl rand -base64 48
AUTH_JWT_SECRET=replace-with-a-secret-at-least-32-characters
AUTH_TOKEN_TTL_SECONDS=86400
